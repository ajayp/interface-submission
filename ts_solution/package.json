{
  "name": "ts-solution",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "eval": "node --experimental-strip-types --no-warnings src/cli.ts eval --eval ../eval/public_eval.jsonl",
    "ask": "node --experimental-strip-types --no-warnings src/cli.ts ask",
    "conflicts": "node --experimental-strip-types --no-warnings src/cli.ts conflicts"
  },
  "dependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
